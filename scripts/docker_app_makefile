export DOCKER_DEFAULT_PLATFORM=linux/amd64

PROJECT_DIR :=	$(realpath $(dir $(lastword\
					$(realpath $(dir $(lastword\
						$(MAKEFILE_LIST)))))))

CONTEXT := ${PROJECT_DIR}
ENV_FOLDER := ${PROJECT_DIR}/env
CONTAINERS := ${PROJECT_DIR}/containers
ENV_FILE ?= .env
ENV_FILE := ${ENV_FOLDER}/${ENV_FILE}

# Fallback to .env.example if ENV_FILE doesn't exist
ifeq (,$(wildcard $(ENV_FILE)))
    ENV_FILE := ${ENV_FOLDER}/.env.example
endif

DC_PROD = docker compose -f ${CONTAINERS}/docker-compose.yml -f ${CONTAINERS}/docker-compose.prod.yml
DC_DEV = docker compose -f ${CONTAINERS}/docker-compose.yml -f ${CONTAINERS}/docker-compose.dev.yml

include $(ENV_FILE)

export CONTEXT
export CONTAINERS
export ENV_FILE
export LOG

export PORT
export SMTP__PORT
export POSTGRES__DB
export POSTGRES__USER
export POSTGRES__PASSWORD


prod_up_fg:
	${DC_PROD} up

prod_up:
	${DC_PROD} up -d

prod_build:
	${DC_PROD} build

prod_down:
	${DC_PROD} down --remove-orphans


up_fg:
	${DC_DEV} up

up:
	${DC_DEV} up -d

build:
	${DC_DEV} build

down:
	${DC_DEV} down --remove-orphans


logs:
	${DC_DEV} logs app

test:
	${DC_DEV} run --rm app /app/.venv/bin/python -m pytest .

migrate:
	${DC_DEV} run --rm app /app/.venv/bin/python -m alembic upgrade head

downgrade:
	${DC_DEV} run --rm app /app/.venv/bin/python -m alembic downgrade -1

migration_create:
	${DC_DEV} run --rm app /app/.venv/bin/python -m alembic revision --autogenerate -m "$(MESSAGE)"

clean_volumes:
	${DC_DEV} down -v --remove-orphans
