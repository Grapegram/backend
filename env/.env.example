# ============================================================================
# Core Application Settings
# ============================================================================

# Project name
PROJECT_NAME=Grapegram

# Debug mode (true for development, false for production)
DEBUG=true

# Secret key for signing tokens and encryption (CHANGE THIS IN PRODUCTION!)
SECRET=your-secret-key-change-this-in-production

# Server host and port
HOST=0.0.0.0
PORT=8000

# API version
API_VERSION=1

# API prefix (optional, defaults to /api/v{version})
# API_PREFIX=/api/v1


# ============================================================================
# CORS Settings
# ============================================================================

# Allowed origins for CORS requests (comma-separated list in JSON array format)
# Note: When allow_credentials=true, you CANNOT use "*" as origin
CORS__ALLOW_ORIGINS='["http://localhost:5173","http://localhost:8128"]'

# Allow credentials (cookies, authorization headers) in CORS requests
CORS__ALLOW_CREDENTIALS=true


# ============================================================================
# Production CORS Example
# ============================================================================
# For production, add your production domains:
# CORS__ALLOW_ORIGINS='["https://yourdomain.com","https://app.yourdomain.com","https://admin.yourdomain.com"]'


# ============================================================================
# JWT Token Settings
# ============================================================================

JWT__ALGORITHM=HS256
JWT__SECRET_KEY=your-secret-key-change-this-in-production

# Token expiration times (in minutes)
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
JWT__REFRESH_TOKEN_EXPIRE_MINUTES=10080  # 7 days
JWT__VERIFICATION_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
JWT__PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60  # 1 hour


# ============================================================================
# Hasher Settings
# ============================================================================

# HASH__HASH_ITERATIONS=600000
HASH__SECRET_KEY=your-secret-key-change-this-in-production


# ============================================================================
# Database Settings (PostgreSQL)
# ============================================================================

# Database driver (e.g., postgresql, mysql, sqlite)
POSTGRES__DRIVER=asyncpg
POSTGRES__HOST=postgres
POSTGRES__PORT=5432
POSTGRES__USER=postgres
POSTGRES__PASSWORD=postgres
POSTGRES__DB=grapegram


# ============================================================================
# Redis Settings
# ============================================================================

# redis driver (e.g., redis, rediss)
REDIS__DRIVER=redis
REDIS__HOST=redis
REDIS__PORT=6379

# You can add if you need
# REDIS__USER=redis
# REDIS__PASSWORD=redis


# ============================================================================
# SMTP Email Settings
# ============================================================================

# SMTP server configuration
SMTP__HOST=mailpit
SMTP__PORT=1025
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__USE_TLS=false

# Email sender information
SMTP__FROM_EMAIL=noreply@grapegram.com
SMTP__FROM_NAME=Grapegram

# Email URL templates
SMTP__VERIFICATION_URL_TEMPLATE=https://grapegram.com/verify-email?token={token}
SMTP__PASSWORD_RESET_URL_TEMPLATE=https://grapegram.com/reset-password?token={token}
SMTP__DASHBOARD_URL=https://grapegram.com/dashboard
SMTP__SUPPORT_EMAIL=support@grapegram.com


# ============================================================================
# Production SMTP Example (Gmail)
# ============================================================================
# Uncomment and configure these for production use with Gmail:
# SMTP__HOST=smtp.gmail.com
# SMTP__PORT=587
# SMTP__USERNAME=your-email@gmail.com
# SMTP__PASSWORD=your-app-specific-password
# SMTP__USE_TLS=true
# SMTP__FROM_EMAIL=noreply@yourdomain.com


# ============================================================================
# Object Storage Settings
# ============================================================================

# Storage backend type: "s3" for S3/MinIO, "azure" for Azure Blob Storage
STORAGE_TYPE=s3


# ============================================================================
# S3/MinIO Object Storage Settings
# ============================================================================

# Kafka bootstrap servers (comma-separated list for multiple brokers)
KAFKA__HOST=kafka
KAFKA__PORT=9092

# Client identification
KAFKA__CLIENT_ID=grapegram

# Consumer group ID
KAFKA__GROUP_ID=grapegram-group

# Auto offset reset strategy (earliest, latest, none)
KAFKA__AUTO_OFFSET_RESET=earliest

# Enable automatic offset commits
KAFKA__ENABLE_AUTO_COMMIT=true


# ============================================================================
# Production Kafka Example
# ============================================================================
# Uncomment and configure these for production use:
# KAFKA__BOOTSTRAP_SERVERS=kafka-broker-1:9092,kafka-broker-2:9092,kafka-broker-3:9092
# KAFKA__CLIENT_ID=grapegram-prod
# KAFKA__GROUP_ID=grapegram-prod-group


# ============================================================================
# S3/MinIO Object Storage Settings
# ============================================================================

# S3-compatible storage endpoint (MinIO for development, AWS S3 for production)
S3__ENDPOINT_URL=http://minio:9000

# S3 access credentials
S3__ACCESS_KEY_ID=admin
S3__SECRET_ACCESS_KEY=password123

S3__REGION_NAME=us-east-1
S3__BUCKET_NAME=grapegram

# Public URL for accessing files (used for generating file URLs)
S3__PUBLIC_URL=http://localhost:9000

# Use SSL/TLS (true for production with AWS S3, false for local MinIO)
S3__USE_SSL=false


# ============================================================================
# Production S3 Example (AWS S3)
# ============================================================================
# Uncomment and configure these for production use with AWS S3:
# S3__ENDPOINT_URL=https://s3.amazonaws.com
# S3__ACCESS_KEY_ID=your-aws-access-key-id
# S3__SECRET_ACCESS_KEY=your-aws-secret-access-key
# S3__REGION_NAME=us-east-1
# S3__BUCKET_NAME=your-production-bucket
# S3__PUBLIC_URL=https://your-bucket.s3.amazonaws.com
# S3__USE_SSL=true


# ============================================================================
# Azure Blob Storage Settings
# ============================================================================
# Note: Set STORAGE_TYPE=azure to use Azure Blob Storage

# Option 1: Using connection string (recommended)
# AZURE__CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net

# Option 2: Using account name and key
# AZURE__ACCOUNT_NAME=your-storage-account
# AZURE__ACCOUNT_KEY=your-account-key

# Container name for storing files
# AZURE__CONTAINER_NAME=grapegram

# Public URL for accessing files (optional, auto-generated if not provided)
# AZURE__PUBLIC_URL=https://your-account.blob.core.windows.net


# ============================================================================
# Production Azure Example
# ============================================================================
# Uncomment and configure these for production use with Azure:
# STORAGE_TYPE=azure
# AZURE__CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourprodaccount;AccountKey=your-production-key;EndpointSuffix=core.windows.net
# AZURE__CONTAINER_NAME=grapegram-production
